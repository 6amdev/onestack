# OneStack Configuration
# Copy to .env and update values

# ===========================
# CORE SETTINGS
# ===========================
APP_NAME=OneStack
NODE_ENV=production
SERVER_URL=http://localhost:1337/parse
DOMAIN=localhost

# ===========================
# SECURITY - CHANGE THESE!
# ===========================
# Parse Server
APP_ID=CHANGE_THIS_TO_RANDOM_STRING_MIN_32_CHARS
MASTER_KEY=CHANGE_THIS_TO_RANDOM_STRING_MIN_64_CHARS

# MongoDB
MONGO_USER=admin
MONGO_PASS=CHANGE_THIS_TO_STRONG_PASSWORD
MONGO_DB=parse

# Redis
REDIS_PASS=CHANGE_THIS_TO_STRONG_PASSWORD

# Dashboard
DASHBOARD_USER=admin
DASHBOARD_PASS=CHANGE_THIS_TO_STRONG_PASSWORD

# ===========================
# OPTIONAL SETTINGS
# ===========================
# SSL
SSL_EMAIL=admin@example.com

# Monitoring
ENABLE_MONITORING=false
GRAFANA_USER=admin
GRAFANA_PASS=admin

# Backup
BACKUP_RETENTION_DAYS=7